# Copy to .env. Never commit credentials. Development model != runtime provider.
APP_ENV=local
DATABASE_URL=sqlite:///./.research-platform/platform.db
ARTIFACT_ROOT=./.research-platform/artifacts
CHECKPOINT_PATH=./.research-platform/checkpoints.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_RESEARCH_PROFILE=demo
DEFAULT_MODEL_PROVIDER=mock
DEFAULT_MODEL=mock-researcher
# Select current models using Settings / provider discovery; no remote model is pinned.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-platform
MAX_RESEARCH_ITERATIONS=3
MAX_LLM_CALLS_PER_RUN=20
MAX_EXPERIMENT_RUNTIME_SECONDS=60
MAX_RUN_RUNTIME_SECONDS=300
MAX_CONCURRENT_JOBS=1
DAILY_API_CALL_BUDGET=100
RESEARCH_CPU_IMAGE=python:3.12-slim
UPSTREAM_RESULTS_ROOT=./results
INSPECTOR_URL=http://127.0.0.1:8765
# OpenAlex may require a free key/account depending on current service policy.
OPENALEX_API_KEY=

# Groq fail-closed policy: verify Free plan/no paid usage in Console first.
# Key-bound attestation expires after 24h; never infer it from discovery or HTTP 200.
GROQ_FREE_TIER_VERIFIED_AT=
GROQ_FREE_TIER_KEY_SHA256=
