[Unit]
Description=Original-engine capability and dry-run controller (guest VM only)
Requires=agsci-daemon.service agsci-research.slice
After=agsci-daemon.service agsci-research.slice
ConditionVirtualization=!container

[Service]
Type=simple
User=agsci-worker
Group=agsci-worker
WorkingDirectory=/opt/agsci-worker/repository
EnvironmentFile=/etc/agsci-worker/worker.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/opt/agsci-worker/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/agsci-worker/venv/bin/python -m src.research_platform.upstream_worker --host 127.0.0.1 --port 8801
Slice=agsci-research.slice
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=45
SendSIGKILL=yes
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agsci-worker/jobs
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
