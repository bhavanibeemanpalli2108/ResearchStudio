# Install privately as /etc/agsci-worker/worker.env; do not copy workstation .env.
RESEARCH_UPSTREAM_WORKER_ENABLED=1
RESEARCH_UPSTREAM_CAMPAIGNS_ENABLED=0
RESEARCH_UPSTREAM_WORKER_ROOT=/var/lib/agsci-worker/jobs
RESEARCH_UPSTREAM_WORKER_TOKEN=
RESEARCH_UPSTREAM_ISOLATION_ACK=dedicated-disposable-worker-v1
RESEARCH_UPSTREAM_AGENT_ENV_FILE=/etc/agsci-worker/agent.env
RESEARCH_UPSTREAM_DOCKER_HOST=unix:///run/agsci-docker.sock
RESEARCH_UPSTREAM_DOCKER_DATA_ROOT=/var/lib/agsci-docker
RESEARCH_UPSTREAM_DAEMON_CONFIG=/etc/agsci-worker/daemon.json
RESEARCH_UPSTREAM_CGROUP=/sys/fs/cgroup/agsci.slice/agsci-research.slice
# Preload an operator-reviewed image; capability checks resolve its content ID.
RESEARCH_UPSTREAM_AGENT_IMAGE=agentic-scientist/agent-cli:latest
