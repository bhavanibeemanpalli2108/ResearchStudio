# TRUSTED HOST ONLY; never copy this file/key to the disposable worker.
RESEARCH_GATEWAY_ENABLED=0
RESEARCH_GATEWAY_HOST_ACK=outside-disposable-worker-v1
RESEARCH_GATEWAY_DATABASE_URL=
RESEARCH_GATEWAY_PROVIDER_KEY_FILE=
# Use the same platform-wide setting as the native services.
DAILY_API_CALL_BUDGET=100
# TLS is required by the explicit gateway launcher. No provider key value here.
